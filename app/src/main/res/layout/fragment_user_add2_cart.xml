<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="Consumer.UserAdd2CartFragment"
        android:background="@color/green_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Cart"
                android:textStyle="bold"
                android:textColor="@color/blue_7100"
                android:fontFamily="@font/bungee"
                android:textSize="22sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp" />

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cartRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:clipToPadding="false"
                android:padding="4dp"
                tools:listitem="@layout/cart_layout" />
            <!-- 🛒 Empty Cart Placeholder -->
            <LinearLayout
                android:id="@+id/emptyCartLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/emptyslide"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_marginBottom="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/emptycart" />
                <TextView
                    android:id="@+id/emptyCartText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your cart is empty!"
                    android:textSize="18sp"
                    android:textColor="@color/gray_dark"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start adding fresh products now 🌿"
                    android:textSize="14sp"
                    android:textColor="@color/gray_dark"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
            <!-- Total Price Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Price:"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/total_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹1000"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/blue_7100" />
            </LinearLayout>

            <!-- Buy All Button -->
            <Button
                android:id="@+id/buyall_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buy All"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/green_600"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:elevation="4dp" />
        </LinearLayout>
    </FrameLayout>
</layout>

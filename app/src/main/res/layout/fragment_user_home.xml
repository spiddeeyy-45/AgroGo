<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="Consumer.UserHomeFragment">

        <RelativeLayout
            android:id="@+id/main_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Top Bar -->
            <LinearLayout
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome To The world of organic Farming ! "
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_gravity="center" />

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:queryHint="Search here..."
                    app:iconifiedByDefault="false"
                    android:background="@drawable/searchbar"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>

            <!-- Scrollable Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/top_bar"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/icon_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="20dp">

                    <!-- Icons Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:weightSum="3"
                        android:layout_marginBottom="10dp">

                        <!-- Fruit Icon -->
                        <LinearLayout
                            android:id="@+id/fruit_icon"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:background="@drawable/fr" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fruit"
                                android:textStyle="bold"
                                android:layout_marginTop="5dp"/>
                        </LinearLayout>

                        <!-- Vegetable Icon -->
                        <LinearLayout
                            android:id="@+id/veg_icon"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:background="@drawable/veg" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="vegetable"
                                android:textStyle="bold"
                                android:layout_marginTop="5dp"/>
                        </LinearLayout>

                        <!-- Grain Icon -->
                        <LinearLayout
                            android:id="@+id/grainIcon"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:background="@drawable/seed" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Grain"
                                android:textStyle="bold"
                                android:layout_marginTop="5dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Offer Hoarding Slider -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/offer_hoarding"
                        android:layout_width="300dp"
                        android:layout_height="150dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="10dp" />

                    <!-- Featured Items -->
                    <LinearLayout
                        android:id="@+id/recy1_user"
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:orientation="horizontal"
                        android:background="@color/blue_500"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="150dp"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:layout_margin="2dp"
                            android:background="@drawable/recyclervie">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="welcome to the world of organic farming with great farmer that are closer to your surrounding"
                                android:textStyle="bold"
                                android:textColor="@color/blue_700"
                                android:textSize="20dp"
                                android:textAlignment="center" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/featured_item"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            tools:listitem="@layout/featuredrecylcer"/>
                    </LinearLayout>

                    <!-- Most Ordered Section -->
                    <LinearLayout
                        android:id="@+id/mostview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/most_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Most Ordered :"
                            android:textStyle="bold"
                            android:layout_marginTop="5dp"
                            android:layout_marginLeft="5dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:background="@drawable/navbar">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/most_recy"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="5dp"
                                tools:listitem="@layout/mostordered"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Recently Ordered Section -->
                    <TextView
                        android:id="@+id/recent_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recently Ordered :"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:layout_marginLeft="5dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recentrecy"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="5dp"/>
                </LinearLayout>
            </ScrollView>
        </RelativeLayout>
    </FrameLayout>
</layout>

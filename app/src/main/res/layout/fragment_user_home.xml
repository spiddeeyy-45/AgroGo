<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Consumer.UserHomeFragment">

        <RelativeLayout
            android:id="@+id/main_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/blue_700"
                android:layout_marginTop="10dp"
                android:layout_gravity="center"
                android:text="Welcome To The world of organic Farming ! "/>
            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchIcon"
             android:layout_width="390dp"
             android:layout_height="wrap_content"
             app:queryHint="Search here..."
             app:iconifiedByDefault="false"
             android:background="@drawable/searchbar"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="10dp"/>
        </LinearLayout>
            <ScrollView
                android:layout_marginTop="90dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/icon_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/fruit_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/fr"
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="110dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fruit"
                    android:textStyle="bold"
                    android:layout_marginLeft="120dp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/veg_icon"
                android:layout_marginLeft="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/fruit_icon"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/veg"
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="vegetbale"
                    android:textStyle="bold"
                    android:layout_marginLeft="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="10dp"
                android:layout_toRightOf="@id/veg_icon">
                <ImageView
                    android:id="@+id/grainIcon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/seed"
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grain"
                    android:textStyle="bold"
                    android:layout_marginLeft="20dp"/>
            </LinearLayout>
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/offer_hoarding"
                        android:layout_width="300dp"
                        android:layout_height="150dp"
                        android:layout_centerHorizontal="true"
                        android:layout_below="@id/veg_icon"
                        android:layout_marginTop="10dp"/>
                    <LinearLayout
                        android:id="@+id/recy1_user"
                        android:layout_width="500dp"
                        android:background="@color/blue_500"
                        android:layout_below="@+id/offer_hoarding"
                        android:layout_height="200dp"
                        android:layout_marginTop="10dp">
                        <LinearLayout
                            android:layout_width="150dp"
                            android:layout_height="200dp"
                            android:layout_margin="2dp"
                            android:orientation="horizontal"
                            android:background="@drawable/recyclervie">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="welcome to the world of or ganic farming
                                with great farmer that are closer to your surrounding "
                                android:textStyle="bold"
                                android:textColor="@color/blue_700"
                                android:textSize="20dp"
                                android:textAlignment="center"/>
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/featured_item"
                            android:layout_width="255dp"
                            android:layout_height="200dp"
                            android:layout_marginLeft="2dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/mostview"
                        android:layout_marginTop="10dp"
                        android:layout_below="@id/recy1_user"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                        android:id="@+id/most_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Most Ordered :"
                        android:layout_marginTop="5dp"
                        android:textStyle="bold"
                        android:layout_marginLeft="5dp"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/navbar">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/most_recy"
                        android:layout_width="410dp"
                        android:layout_height="200dp"
                        android:layout_marginLeft="5dp"
                        />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/recent_tag"
                        android:layout_marginTop="5dp"
                        android:layout_marginLeft="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recently Ordered :"
                        android:textStyle="bold"
                        android:layout_below="@id/mostview"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="410dp"
                        android:layout_height="200dp"
                        android:layout_below="@+id/recent_tag"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="5dp"/>
                </RelativeLayout>

            </ScrollView>
            </RelativeLayout>

</FrameLayout>
</layout>

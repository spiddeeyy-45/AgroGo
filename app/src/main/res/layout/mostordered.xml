<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/prod_image2"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_alignParentStart="true"
            android:scaleType="centerCrop"
            android:src="@drawable/vl"
            android:contentDescription="Product image" />

        <!-- Product Name -->
        <TextView
            android:id="@+id/prod_name2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apple"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:fontFamily="@font/bungee"
            android:layout_toRightOf="@id/prod_image2"
            android:layout_marginStart="12dp"
            android:layout_alignParentTop="true"/>

        <!-- Product Price Label -->
        <TextView
            android:id="@+id/prod_price2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price:"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_below="@id/prod_name2"
            android:layout_toRightOf="@id/prod_image2"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"/>

        <!-- Product Price Value -->
        <TextView
            android:id="@+id/prod_prices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹120"
            android:textColor="@color/black"
            android:layout_alignBaseline="@id/prod_price2"
            android:layout_toRightOf="@id/prod_price2"
            android:layout_marginStart="8dp"/>

        <!-- Product Description -->
        <TextView
            android:id="@+id/prod_desc2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Packed with fiber"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/antic"
            android:layout_below="@id/prod_price2"
            android:layout_toRightOf="@id/prod_image2"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"/>

        <!-- Horizontal Button Layout -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/prod_desc2"
            android:layout_toRightOf="@id/prod_image2"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp">

            <!-- Buy Button -->
            <Button
                android:id="@+id/btnBuy2"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:text="Buy"
                android:backgroundTint="@color/green_700"
                android:textColor="@android:color/white"
                android:elevation="3dp"
                android:layout_marginEnd="10dp"/>

            <!-- Cart Button -->
            <Button
                android:id="@+id/btnCart"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:text="Cart"
                android:backgroundTint="@color/brown_700"
                android:textColor="@android:color/white"
                android:elevation="3dp"/>
        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>

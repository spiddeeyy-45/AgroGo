<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Farmer.HomeFragment">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/backla"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="700dp"
        android:layout_marginTop="-30dp"
        app:layout_constraintTop_toBottomOf="@id/topview"
        app:layout_constraintLeft_toLeftOf="@id/backla"
        app:layout_constraintRight_toRightOf="@id/backla"
        android:background="@drawable/farmerlayout">
        <TextView
            android:id="@+id/livestocktag"
            android:layout_marginTop="70dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/green_500"
            android:layout_marginLeft="10dp"
            android:text="Live Stock"
            android:fontFamily="@font/bungee"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/LivestockHandler"
            android:layout_width="400dp"
            android:layout_height="match_parent"
            android:layout_below="@+id/livestocktag"
            android:layout_marginTop="5dp"
            tools:listitem="@layout/farmer_product"
            android:layout_marginLeft="5dp"/>

    </RelativeLayout>
        <LinearLayout
            android:id="@+id/topview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/namelayout"
            app:layout_constraintTop_toTopOf="@id/backla"
            app:layout_constraintLeft_toLeftOf="@id/backla"
            app:layout_constraintRight_toRightOf="@id/backla"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F4F3"
                android:text="Welcome !"
                android:textStyle="bold"
                android:fontFamily="@font/antic"
                android:textSize="20sp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="20dp"/>
            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textSize="30sp"
                android:layout_marginTop="-17dp"
                android:layout_marginLeft="10dp"
                android:fontFamily="@font/bungee"
                android:textColor="#F4F4F3"/>
        </LinearLayout>
        <ImageView
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:src="@drawable/vl"
            android:layout_marginLeft="180dp"
            android:layout_marginTop="-80dp"
            app:layout_constraintRight_toRightOf="@id/backla"
            app:layout_constraintTop_toTopOf="@id/backla"
            app:layout_constraintLeft_toLeftOf="@id/backla"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
</layout>
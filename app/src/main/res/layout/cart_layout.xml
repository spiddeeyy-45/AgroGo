<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="10dp"
    android:layout_margin="5dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp">
        <ImageView
            android:id="@+id/prod_imageCart"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/vl"
            android:layout_margin="5dp"/>
        <TextView
            android:id="@+id/prod_nameCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ProductName"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/blue_700"
            android:layout_toRightOf="@+id/prod_imageCart"
            android:layout_margin="5dp"/>
        <TextView
            android:id="@+id/prod_descCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="hhhhhhhhhhhhhh"
            android:textColor="@color/blue_700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_below="@+id/prod_nameCart"
            android:layout_toRightOf="@+id/prod_imageCart"
            android:layout_margin="3dp"/>
        <TextView
            android:id="@+id/prod_priceTagCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price : "
            android:textStyle="bold"
            android:layout_below="@+id/prod_descCart"
            android:layout_toRightOf="@+id/prod_imageCart"
            android:layout_margin="4dp"/>
        <TextView
            android:id="@+id/prod_priceCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:textStyle="bold"
            android:layout_margin="4dp"
            android:layout_below="@+id/prod_descCart"
            android:layout_toRightOf="@+id/prod_priceTagCart"/>
        <Button
            android:id="@+id/buyBTNCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="buy"
            android:layout_margin="5dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"/>
        <Button
            android:id="@+id/removeBTNCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="remove"
            android:layout_margin="5dp"
            android:layout_alignParentBottom="true"
            android:layout_toLeftOf="@+id/buyBTNCart"/>
    </RelativeLayout>

</androidx.cardview.widget.CardView>
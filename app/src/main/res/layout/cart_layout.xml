<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/prod_imageCart"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_margin="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/vl"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Product Name -->
        <TextView
            android:id="@+id/prod_nameCart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Product Name"
            android:textColor="@color/blue_700"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/prod_imageCart"
            app:layout_constraintTop_toTopOf="@id/prod_imageCart"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Product Description -->
        <TextView
            android:id="@+id/prod_descCart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="8dp"
            android:text="Fresh and organic"
            android:textColor="@color/blue_700"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/prod_imageCart"
            app:layout_constraintTop_toBottomOf="@id/prod_nameCart"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Price Label -->
        <TextView
            android:id="@+id/prod_priceTagCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:text="Price:"
            android:textStyle="bold"
            android:textColor="@color/blue_700"
            app:layout_constraintStart_toEndOf="@id/prod_imageCart"
            app:layout_constraintTop_toBottomOf="@id/prod_descCart" />

        <!-- Price Value -->
        <TextView
            android:id="@+id/prod_priceCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="₹100"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@id/prod_priceTagCart"
            app:layout_constraintTop_toTopOf="@id/prod_priceTagCart" />

        <!-- Remove Button -->

        <Button
            android:id="@+id/removeBTNCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_editor_absoluteX="100dp"
            android:backgroundTint="@color/red_400"
            android:text="Remove"
            app:layout_constraintLeft_toRightOf="@id/prod_imageCart"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:layout_marginLeft="10dp"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/buyBTNCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:backgroundTint="@color/green_600"
            android:text="Buy"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/removeBTNCart" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>

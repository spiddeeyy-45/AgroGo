<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/green_light">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/image2"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="10dp"
            android:scaleType="centerCrop"
            android:src="@drawable/vl"
            android:contentDescription="Product image"
            android:elevation="3dp" />

        <!-- Product Name -->
        <TextView
            android:id="@+id/name2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Organic Apple"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:fontFamily="@font/bungee"
            android:layout_toRightOf="@id/image2"
            android:layout_marginStart="14dp"
            android:layout_alignParentTop="true" />

        <!-- Product Price -->
        <TextView
            android:id="@+id/price2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price:"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_below="@id/name2"
            android:layout_toRightOf="@id/image2"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/prod_prices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹180"
            android:textColor="@color/brown_900"
            android:textStyle="bold"
            android:layout_alignBaseline="@id/price2"
            android:layout_toRightOf="@id/price2"
            android:layout_marginStart="8dp"/>

        <!-- Product Description -->
        <TextView
            android:id="@+id/desc2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delivered fresh from local farms"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/antic"
            android:textSize="13sp"
            android:layout_below="@id/price2"
            android:layout_toRightOf="@id/image2"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp" />



        <!-- Horizontal Button Layout -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/desc2"
            android:layout_toRightOf="@id/image2"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginStart="14dp">

            <!-- Reorder Button -->
            <Button
                android:id="@+id/Buy2"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:text="Buy"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/green_700"
                android:elevation="3dp"
                android:layout_marginEnd="10dp" />

            <!-- Track Button -->
            <Button
                android:id="@+id/Cart"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:text="cart"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/brown_700"
                android:elevation="3dp" />
        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>
